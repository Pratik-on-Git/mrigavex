# Copy to .env.local and fill in. Never commit real values.

# ── Site ────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, the sitemap and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (MongoDB) ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=mrigavex

# ── Admin authentication ────────────────────────────────────────────
# The ONLY email allowed to sign in to /admin. Login for any other address is
# refused even if a matching record exists in the database.
ADMIN_EMAIL=owner@example.com
# Signs session and sign-in-challenge tokens. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every session out.
AUTH_SECRET=

# ── Mail (SMTP) ─────────────────────────────────────────────────────
# Required in production: admin sign-in codes are emailed. Port 465 uses
# implicit TLS, anything else STARTTLS.
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
# Where new-lead alerts go (comma-separated). Falls back to ADMIN_EMAIL.
LEAD_NOTIFICATION_EMAIL=
